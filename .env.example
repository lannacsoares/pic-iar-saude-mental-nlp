# Copie para .env e preencha. O arquivo .env esta no .gitignore.

# Hugging Face (Datasets + Hub): https://huggingface.co/settings/tokens
HF_TOKEN=

# Weights & Biases: https://wandb.ai/authorize
WANDB_API_KEY=
WANDB_PROJECT=pic-iar-saude-mental
WANDB_ENTITY=

# MLflow (no Databricks o tracking ja vem configurado; localmente use um diretorio)
MLFLOW_TRACKING_URI=./mlruns

# Databricks (apenas se usar o CLI/SDK a partir da maquina local)
DATABRICKS_HOST=
DATABRICKS_TOKEN=
